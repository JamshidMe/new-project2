# Gmail SMTP (direct sending to your Gmail inbox)
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an App Password: Google Account -> Security -> App passwords.
# 3. Paste the 16-character App Password below (spaces are okay).
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your 16 character app password

# Where RSVP messages should arrive
RSVP_TO=jamshidbekmarufjonov6@gmail.com

# Local mail server port (Vite proxies /api to it)
RSVP_PORT=8787

# Optional music source. Default: YouTube "Azizam" starting at 0:43.
VITE_MUSIC_YOUTUBE_ID=oBzE7gDRbdo
VITE_MUSIC_START=43
# Or use a direct audio URL instead (only used if the YouTube ID is empty):
VITE_MUSIC_URL=

# Optional: only needed if you deploy the frontend separately from the mail server
VITE_RSVP_API_URL=
VITE_RSVP_EMAIL=jamshidbekmarufjonov6@gmail.com
